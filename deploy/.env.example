# Copy to /srv/live-room/.env on the server and fill in by hand. Never commit
# the real file. No quotes around values. deploy.sh refuses to run if any name
# below is empty.
# Compose sets DATABASE_URL, REDIS_URL, REPLICA_NAME, PORT, LIVEKIT_HOST,
# TRUST_PROXY and NODE_ENV itself, so they are not listed here.

# Signs the guest and admin cookies; 32+ random characters.
COOKIE_SECRET=
# Shared secret the house worker sends with x-house-key; 32+ random characters.
HOUSE_KEY=
# Password for /admin.
ADMIN_PASSWORD=
# Agora project App ID (co-host authentication must be on for the project).
AGORA_APP_ID=
# Agora project App Certificate.
AGORA_APP_CERT=
# Where phones reach LiveKit: wss://livekit.tahmidalavi.com
LIVEKIT_URL=
# LiveKit API key, any name without spaces.
LIVEKIT_API_KEY=
# LiveKit API secret; 32+ random characters.
LIVEKIT_API_SECRET=
# Public origin of the app, used for CORS and the socket: https://live.tahmidalavi.com
WEB_ORIGIN=
# Percent of each gift the host keeps: 60
HOST_SHARE_PCT=
# Free Agora minutes per month; the video room pauses at 80% of this: 10000
AGORA_FREE_MINUTES=
# Monthly transfer allowance of the VPS plan in TB; sets the chart's budget line.
BUDGET_TB_MONTH=
