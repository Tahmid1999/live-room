[Unit]
Description=Live Room LiveKit node
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/live-room-livekit/keys.env
ExecStart=/opt/live-room-livekit/livekit-server --config /etc/live-room-livekit/livekit.yaml
# A restart drops everyone in every room, video and audio.
Restart=on-failure
RestartSec=3
# A throwaway user with no home and a read-only view of the system: every port
# is above 1024, so it needs nothing from root.
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
LimitNOFILE=65536
# The box's main job is someone else's live calls; this node never gets more
# than two cores or 512 MB of it.
CPUQuota=200%
MemoryMax=512M

[Install]
WantedBy=multi-user.target
